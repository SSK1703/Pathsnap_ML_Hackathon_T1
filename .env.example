# Path to the root of the supplied raw dataset
PATHSNAP_DATA_ROOT=data/raw

# Project configuration
PATHSNAP_CONFIG=config/config.yaml

# Logging
PATHSNAP_LOG_LEVEL=INF

# API configuration
PATHSNAP_HOST=0.0.0.0
PATHSNAP_PORT=8000

# Frontend
PATHSNAP_API_URL=http://127.0.0.1:8000

# API allowed frontend origins
PATHSNAP_ALLOWED_ORIGINS=http://localhost:8501

# Evaluator trip manifest
PATHSNAP_TRIP_MANIFEST=data/evaluator_trip_manifest.csv

# Reproducibility
PATHSNAP_RANDOM_SEED=42
